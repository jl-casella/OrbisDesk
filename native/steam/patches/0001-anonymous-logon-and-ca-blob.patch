+// OrbisDesk: the fields SteamKit2's LogOnAnonymous sends; no account, no token, no
+// should_remember_password.
+std::vector<std::uint8_t> EncodeAnonymousLogon(std::uint32_t cell_id, const DeviceIdentity& device) {
+  proto::Writer body;
+  body.AddVarint(1, kProtocolVersion);
+  body.AddVarint(3, cell_id);
+  body.AddVarint(5, kClientPackageVersion);
+  body.AddString(6, "english");
+  body.AddVarint(7, 0);  // EOSType WinUnknown, as EncodeLogon
+  body.AddBytes(30, device.machine_id);
+  if (!body.ok()) return {};
+  return body.bytes();
+}
