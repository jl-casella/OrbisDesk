From 7b9f9026da6c38904cbf4c075c16f02a505d160d Mon Sep 17 00:00:00 2001
From: OrbisWinPrototype <orbis-win@localhost>
Date: Fri, 30 Oct 2026 22:22:09 -0300
Subject: [PATCH] Implement madvise with FreeBSD advisory semantics

madvise resolved to a stub. FreeBSD advice up to MADV_CORE only hints the
pager and keeps page contents, so validate the range and the advice and
return success without asking the host, whose MADV_DONTNEED would discard
anonymous pages. MADV_PROTECT needs privilege and fails with EPERM; unknown
advice and overflowing ranges fail with EINVAL.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/core/libraries/kernel/memory.cpp | 19 +++++++++++++++++++
 1 file changed, 19 insertions(+)

diff --git a/src/core/libraries/kernel/memory.cpp b/src/core/libraries/kernel/memory.cpp
index 99e9d25..add2435 100644
--- a/src/core/libraries/kernel/memory.cpp
+++ b/src/core/libraries/kernel/memory.cpp
@@ -863,6 +863,23 @@ s32 PS4_SYSV_ABI posix_munmap(void* addr, u64 len) {
     return result;
 }
 
+s32 PS4_SYSV_ABI posix_madvise(void* addr, u64 len, s32 advice) {
+    // FreeBSD advice up to MADV_CORE only hints the pager and keeps page contents; Linux's
+    // MADV_DONTNEED would discard anonymous pages, so the host is not asked.
+    constexpr s32 MadvCore = 9;
+    constexpr s32 MadvProtect = 10;
+    const VAddr raw_addr = reinterpret_cast<VAddr>(addr);
+    if (raw_addr + len < raw_addr || advice < 0 || advice > MadvProtect) {
+        *__Error() = POSIX_EINVAL;
+        return -1;
+    }
+    if (advice > MadvCore) {
+        *__Error() = POSIX_EPERM;
+        return -1;
+    }
+    return 0;
+}
+
 s32 PS4_SYSV_ABI posix_mlock(const void* addr, u64 len) {
     if (!addr || len == 0) {
         *__Error() = POSIX_EINVAL;
@@ -1044,6 +1061,8 @@ void RegisterMemory(Core::Loader::SymbolsResolver* sym) {
     LIB_FUNCTION("UqDGjXA5yUM", "libkernel", 1, "libkernel", posix_munmap);
     LIB_FUNCTION("UqDGjXA5yUM", "libScePosix", 1, "libkernel", posix_munmap);
     LIB_FUNCTION("3k6kx-zOOSQ", "libkernel", 1, "libkernel", sceKernelMlock);
+    LIB_FUNCTION("Jahsnh4KKkg", "libkernel", 1, "libkernel", posix_madvise);
+    LIB_FUNCTION("Jahsnh4KKkg", "libScePosix", 1, "libkernel", posix_madvise);
     LIB_FUNCTION("mTBZfEal2Bw", "libkernel", 1, "libkernel", posix_mlock);
     LIB_FUNCTION("mTBZfEal2Bw", "libScePosix", 1, "libkernel", posix_mlock);
     LIB_FUNCTION("xQIIfJ860sk", "libkernel", 1, "libkernel", sceKernelMunlock);
