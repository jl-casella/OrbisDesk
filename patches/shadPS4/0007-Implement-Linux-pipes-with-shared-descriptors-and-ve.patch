+    if (Core::Net::GetObjectKind(fd) == Core::Net::NetObjectKind::Pipe) {
+        *__Error() = POSIX_ESPIPE;
+        return -1;
+    }
     if (offset < 0) {
         *__Error() = POSIX_EINVAL;
         return -1;
@@ -1861,11 +1929,26 @@ s32 PS4_SYSV_ABI posix_select(s32 nfds, GuestFdSet* readfds, GuestFdSet* writefd
 }
 
 s32 PS4_SYSV_ABI posix_pipe(s32* descriptors) {
-    *__Error() = descriptors ? POSIX_EOPNOTSUPP : POSIX_EFAULT;
-    return -1;
+    if (!descriptors) {
+        *__Error() = POSIX_EFAULT;
+        return -1;
+    }
+    s32 created[2];
+    const auto result = Core::Net::PipeCreate(created);
+    if (result.error != Core::Net::Host::Error::Ok) {
+        *__Error() = Libraries::Net::ToOrbisErrno(result.error);
+        return -1;
+    }
+    descriptors[0] = created[0];
+    descriptors[1] = created[1];
+    return 0;
 }
 
