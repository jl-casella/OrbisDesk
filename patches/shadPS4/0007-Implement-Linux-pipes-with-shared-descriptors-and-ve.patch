+    if (Core::Net::GetObjectKind(fd) == Core::Net::NetObjectKind::Pipe) {
+        *__Error() = POSIX_ESPIPE;
+        return -1;
+    }
     if (offset < 0) {
         *__Error() = POSIX_EINVAL;
         return -1;
@@ -1636,6 +1700,10 @@ s64 PS4_SYSV_ABI sceKernelGetdirentries(s32 fd, char* buf, u64 nbytes, s64* base
 }
 
