     if (file->type == Core::FileSys::FileType::Device) {
@@ -574,6 +630,10 @@ s64 PS4_SYSV_ABI posix_lseek(s32 fd, s64 offset, s32 whence) {
         *__Error() = POSIX_EBADF;
         return -1;
     }
+    if (Core::Net::GetObjectKind(fd) == Core::Net::NetObjectKind::Pipe) {
+        *__Error() = POSIX_ESPIPE;
+        return -1;
+    }
 
     std::scoped_lock lk{file->m_mutex};
     if (file->type == Core::FileSys::FileType::Device) {
@@ -1429,6 +1489,10 @@ s32 PS4_SYSV_ABI sceKernelRename(const char* from, const char* to) {
 }
 
