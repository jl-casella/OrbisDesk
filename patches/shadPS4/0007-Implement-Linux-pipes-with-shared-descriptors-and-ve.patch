+static s64 NetworkVectorIO(s32 fd, const OrbisKernelIovec* iov, s32 count, bool writing) {
+    if (count < 0 || count > 1024 || (count && !iov)) {
+        *__Error() = POSIX_EINVAL;
+        return -1;
+    }
+    size_t size = 0;
+    for (s32 index = 0; index < count; ++index) {
+        if (iov[index].iov_len && !iov[index].iov_base) {
+            *__Error() = POSIX_EFAULT;
+            return -1;
+        }
+        if (iov[index].iov_len > INT32_MAX - size) {
+            *__Error() = POSIX_EINVAL;
+            return -1;
+        }
+        size += iov[index].iov_len;
+    }
+    std::vector<u8> bytes(size);
+    size_t offset = 0;
+    if (writing) {
+        for (s32 index = 0; index < count; ++index) {
+            if (iov[index].iov_len) {
+                std::memcpy(bytes.data() + offset, iov[index].iov_base, iov[index].iov_len);
+            }
+            offset += iov[index].iov_len;
+        }
+        return Libraries::Net::KernelWrite(fd, bytes.data(), bytes.size());
+    }
+    const auto result = Libraries::Net::KernelRead(fd, bytes.data(), bytes.size());
+    if (result > 0) {
+        for (s32 index = 0; index < count && offset < result; ++index) {
+            const size_t amount = std::min<u64>(iov[index].iov_len, result - offset);
+            if (amount) {
+                std::memcpy(iov[index].iov_base, bytes.data() + offset, amount);
+            }
+            offset += amount;
+        }
+    }
+    return result;
+}
+
