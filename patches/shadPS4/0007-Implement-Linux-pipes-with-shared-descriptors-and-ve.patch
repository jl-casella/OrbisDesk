+NetResult PipeCreate(s32 ids[2]) {
+    Host::NativeSocket native[2];
+    Host::PipeIdentity identity{};
+    if (const auto error = Host::CreatePipe(native, &identity); error != Error::Ok) {
+        return NetResult::Fail(error);
+    }
+    auto reader = std::make_shared<GuestSocket>(native[0], SOCK_STREAM,
+                                                g_next_generation.fetch_add(1), 0, identity);
+    auto writer = std::make_shared<GuestSocket>(native[1], SOCK_STREAM,
+                                                g_next_generation.fetch_add(1), 1, identity);
+    const auto first = g_objects.Insert(std::move(reader));
+    if (first.error != Error::Ok) {
+        return first;
+    }
+    const auto second = g_objects.Insert(std::move(writer));
+    if (second.error != Error::Ok) {
+        SocketClose(static_cast<s32>(first.value));
+        return second;
+    }
+    ids[0] = static_cast<s32>(first.value);
+    ids[1] = static_cast<s32>(second.value);
+    return NetResult::Ok();
+}
+
+NetResult PipeGetInfo(s32 id, PipeInfo* info) {
+    const auto pipe = g_objects.Get<GuestSocket>(id);
+    if (!pipe || pipe->pipe_access < 0) {
+        return NetResult::Fail(Error::BadF);
+    }
+    *info = {pipe->pipe_access, pipe->nonblocking, pipe->pipe_identity};
+    return NetResult::Ok();
+}
+
+NetResult PipeRead(s32 id, void* buffer, size_t size) {
+    const auto pipe = g_objects.Get<GuestSocket>(id);
+    if (!pipe || pipe->pipe_access != 0) {
+        return NetResult::Fail(Error::BadF);
+    }
+    if (!buffer && size) {
+        return NetResult::Fail(Error::Fault);
+    }
+    if (size > INT64_MAX) {
+        return NetResult::Fail(Error::Inval);
+    }
+    if (!size) {
+        return NetResult::Ok();
+    }
+    return RunBlocking(*pipe, Side::Recv, Host::Readable, std::nullopt, !pipe->nonblocking, [&] {
+        const auto result = Host::ReadPipe(pipe->native, buffer, size);
+        return NetResult{result.value, result.error};
+    });
+}
+
+NetResult PipeWrite(s32 id, const void* buffer, size_t size) {
+    const auto pipe = g_objects.Get<GuestSocket>(id);
+    if (!pipe || pipe->pipe_access != 1) {
+        return NetResult::Fail(Error::BadF);
+    }
+    if (!buffer && size) {
+        return NetResult::Fail(Error::Fault);
+    }
+    if (size > INT64_MAX) {
+        return NetResult::Fail(Error::Inval);
+    }
+    if (!size) {
+        return NetResult::Ok();
+    }
+    const auto* bytes = static_cast<const u8*>(buffer);
+    return SendAll(*pipe, size, !pipe->nonblocking, true, [&](size_t sent) {
+        const auto result =
+            Host::WritePipe(pipe->native, bytes + sent, std::min(size - sent, MaxStreamSendChunk));
+        return NetResult{result.value, result.error};
+    });
+}
+
 NetResult SocketCreate(int family, int type, int protocol) {
     // FreeBSD returns EPROTONOSUPPORT for a mismatched protocol, macOS EPROTOTYPE.
     if ((family == AF_INET || family == AF_INET6) && protocol != 0 &&
@@ -1074,6 +1157,9 @@ NetResult SocketGetInfo(s32 id, SocketInfo* info) {
     if (!s) {
         return NetResult::Fail(Error::BadF);
     }
+    if (s->pipe_access >= 0) {
+        return NetResult::Fail(Error::NotSock);
+    }
     info->type = s->type;
     info->p2p = s->IsP2P();
     info->nonblocking = s->nonblocking;
