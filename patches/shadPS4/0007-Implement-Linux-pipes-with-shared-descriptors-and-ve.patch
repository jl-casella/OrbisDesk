 #ifdef _WIN32
 #include <mstcpip.h>
 #include <wepoll.h>
@@ -269,6 +275,67 @@ NativeSocket CreateSocket(int family, int type, int protocol, Error* error) {
     return s;
 }
 
+Error CreatePipe(NativeSocket out[2], PipeIdentity* identity) {
+    out[0] = out[1] = InvalidSocket;
+#ifdef __linux__
+    int descriptors[2];
+    if (pipe2(descriptors, O_NONBLOCK | O_CLOEXEC) < 0) {
+        return LastError();
+    }
+    struct stat status;
+    if (fstat(descriptors[0], &status) < 0) {
+        const auto error = LastError();
+        close(descriptors[0]);
+        close(descriptors[1]);
+        return error;
+    }
+    *identity = {static_cast<u64>(status.st_dev), static_cast<u64>(status.st_ino)};
+    out[0] = descriptors[0];
+    out[1] = descriptors[1];
+    return Error::Ok;
+#else
+    return Error::OpNotSupp;
+#endif
+}
+
+IoResult ReadPipe(NativeSocket pipe, void* buffer, size_t size) {
+#ifdef __linux__
+    const auto result = read(pipe, buffer, size);
+    return {result, result < 0 ? LastError() : Error::Ok};
+#else
+    return {-1, Error::OpNotSupp};
+#endif
+}
+
+IoResult WritePipe(NativeSocket pipe, const void* buffer, size_t size) {
+#ifdef __linux__
+    sigset_t mask, previous, pending;
+    sigemptyset(&mask);
+    sigaddset(&mask, SIGPIPE);
+    const int error = pthread_sigmask(SIG_BLOCK, &mask, &previous);
+    if (error) {
+        return {-1, TranslateNative(error)};
+    }
+    if (sigpending(&pending) < 0) {
+        const auto failure = LastError();
+        pthread_sigmask(SIG_SETMASK, &previous, nullptr);
+        return {-1, failure};
+    }
+    const bool already_pending = sigismember(&pending, SIGPIPE) == 1;
+    const auto result = write(pipe, buffer, size);
+    const auto failure = result < 0 ? LastError() : Error::Ok;
+    if (failure == Error::Pipe && !already_pending) {
+        timespec timeout{};
+        while (sigtimedwait(&mask, nullptr, &timeout) < 0 && errno == EINTR) {
+        }
+    }
+    pthread_sigmask(SIG_SETMASK, &previous, nullptr);
+    return {result, failure};
+#else
+    return {-1, Error::OpNotSupp};
+#endif
+}
+
 Error CreateSocketPair(int family, int type, int protocol, NativeSocket out[2]) {
     out[0] = out[1] = InvalidSocket;
 #ifdef _WIN32
