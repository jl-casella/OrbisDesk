From 6ac41a73e382d6d4674562344f1dc2aac65851c8 Mon Sep 17 00:00:00 2001
From: OrbisWinPrototype <orbis-win@localhost>
Date: Fri, 30 Oct 2026 21:04:01 -0300
Subject: [PATCH] Implement sysarch FS and GS base operations on Linux

AMD64_GET_FSBASE returns the guest TCB; AMD64_GET_GSBASE and
AMD64_SET_GSBASE use the host thread GS base, now unused by the emulator.
AMD64_SET_FSBASE and unknown operations fail with EINVAL, and other hosts
report ENOSYS, leaving the output untouched.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/core/libraries/kernel/kernel.cpp | 48 ++++++++++++++++++++++++++++
 1 file changed, 48 insertions(+)

diff --git a/src/core/libraries/kernel/kernel.cpp b/src/core/libraries/kernel/kernel.cpp
index 573f34b..58a744d 100644
--- a/src/core/libraries/kernel/kernel.cpp
+++ b/src/core/libraries/kernel/kernel.cpp
@@ -4,6 +4,7 @@
 #include <thread>
 #include <boost/asio/io_context.hpp>
 
+#include "common/arch.h"
 #include "common/assert.h"
 #include "common/debug.h"
 #include "common/elf_info.h"
@@ -29,12 +30,18 @@
 #include "core/libraries/libs.h"
 #include "core/libraries/net/net.h"
 #include "core/libraries/net/net_kernel.h"
+#include "core/tls.h"
 
 #ifdef _WIN64
 #include <Rpc.h>
 #else
 #include <uuid/uuid.h>
 #endif
+#if defined(__linux__) && defined(ARCH_X86_64)
+#include <asm/prctl.h>
+#include <sys/syscall.h>
+#include <unistd.h>
+#endif
 #include <common/singleton.h>
 #include <core/linker.h>
 #include "aio.h"
@@ -269,6 +276,46 @@ const char** PS4_SYSV_ABI getargv() {
     return entry_params.argv;
 }
 
+s32 PS4_SYSV_ABI posix_sysarch(s32 op, u64* base) {
+#if defined(__linux__) && defined(ARCH_X86_64)
+    constexpr s32 Amd64GetFsBase = 128;
+    constexpr s32 Amd64GetGsBase = 130;
+    constexpr s32 Amd64SetGsBase = 131;
+    if (base == nullptr) {
+        *Kernel::__Error() = POSIX_EFAULT;
+        return -1;
+    }
+    switch (op) {
+    case Amd64GetFsBase:
+        *base = reinterpret_cast<u64>(Core::GetTcbBase());
+        return ORBIS_OK;
+    case Amd64GetGsBase: {
+        u64 value;
+        if (syscall(SYS_arch_prctl, ARCH_GET_GS, &value) != 0) {
+            SetPosixErrno(errno);
+            return -1;
+        }
+        *base = value;
+        return ORBIS_OK;
+    }
+    case Amd64SetGsBase:
+        if (syscall(SYS_arch_prctl, ARCH_SET_GS, *base) != 0) {
+            SetPosixErrno(errno);
+            return -1;
+        }
+        return ORBIS_OK;
+    default:
+        LOG_ERROR(Lib_Kernel, "unsupported operation {}", op);
+        *Kernel::__Error() = POSIX_EINVAL;
+        return -1;
+    }
+#else
+    LOG_ERROR(Lib_Kernel, "unsupported on this host, operation {}", op);
+    *Kernel::__Error() = POSIX_ENOSYS;
+    return -1;
+#endif
+}
+
 s32 PS4_SYSV_ABI get_authinfo(s32 pid, AuthInfoData* p2) {
     LOG_WARNING(Lib_Kernel, "(STUBBED) called, pid: {}", pid);
     if (p2 == nullptr) {
@@ -503,6 +550,7 @@ void RegisterLib(Core::Loader::SymbolsResolver* sym) {
     LIB_FUNCTION("9BcDykPmo1I", "libkernel", 1, "libkernel", __Error);
     LIB_FUNCTION("k+AXqu2-eBc", "libkernel", 1, "libkernel", posix_getpagesize);
     LIB_FUNCTION("k+AXqu2-eBc", "libScePosix", 1, "libkernel", posix_getpagesize);
+    LIB_FUNCTION("b7uXQmnfB2s", "libkernel", 1, "libkernel", posix_sysarch);
     LIB_FUNCTION("7NwggrWJ5cA", "libkernel", 1, "libkernel", __sys_regmgr_call);
 
     LIB_FUNCTION("mkawd0NA9ts", "libkernel", 1, "libkernel", posix_sysconf);
