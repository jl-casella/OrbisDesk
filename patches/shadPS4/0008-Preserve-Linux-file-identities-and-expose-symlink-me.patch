 #include <unordered_set>
 #include "common/assert.h"
 #include "common/logging/log.h"
@@ -15,6 +16,35 @@
 
 namespace Core::FileSys {
 
+namespace {
+struct IdentityNamespace {
+    std::map<u64, u32> values;
+    std::map<u32, u64> owners;
+    u32 next = 1;
+
+    u32 Get(u64 native) {
+        if (const auto found = values.find(native); found != values.end()) {
+            return found->second;
+        }
+        u32 value = static_cast<u32>(native);
+        while (!value || owners.contains(value)) {
+            value = next++;
+        }
+        owners[value] = native;
+        values[native] = value;
+        return value;
+    }
+};
+std::mutex identity_mutex;
+IdentityNamespace host_devices;
+std::map<u64, IdentityNamespace> host_inodes;
+} // namespace
+
+HostFileIdentity MapHostFileIdentity(u64 device, u64 inode) {
+    std::scoped_lock lock{identity_mutex};
+    return {host_devices.Get(device), inode ? host_inodes[device].Get(inode) : 0};
+}
+
 // Iterates a pre-collected entry list produced by merging the backend stack.
 class MergedDirectory final : public IDirectory {
 public:
