 #include <magic_enum/magic_enum.hpp>
 
 #include "common/assert.h"
@@ -89,6 +93,48 @@ static std::map<std::string, FactoryDevice> available_device = {
 
 namespace Libraries::Kernel {
 
+#ifdef __linux__
+static bool HostBackedPath(const char* path) {
+    const auto* mount = Common::Singleton<Core::FileSys::MntPoints>::Instance()->GetMount(path);
+    return mount && !mount->backends.empty() &&
+           std::ranges::all_of(mount->backends, [](const auto& backend) {
+               return backend->RootHostPath().has_value();
+           });
+}
+
+static void ConvertHostStat(OrbisKernelStat& output, const struct stat& input) {
+    output = {};
+    const auto identity = Core::FileSys::MapHostFileIdentity(input.st_dev, input.st_ino);
+    output.st_dev = identity.device;
+    output.st_ino = identity.inode;
+    output.st_mode = input.st_mode;
+    output.st_nlink = static_cast<u16>(std::min<u64>(input.st_nlink, UINT16_MAX));
+    output.st_uid = input.st_uid;
+    output.st_gid = input.st_gid;
+    output.st_rdev = input.st_rdev;
+    output.st_size = input.st_size;
+    output.st_blocks = input.st_blocks;
+    output.st_blksize = input.st_blksize;
+    output.st_atim = {input.st_atim.tv_sec, input.st_atim.tv_nsec};
+    output.st_mtim = {input.st_mtim.tv_sec, input.st_mtim.tv_nsec};
+    output.st_ctim = {input.st_ctim.tv_sec, input.st_ctim.tv_nsec};
+}
+
+static std::optional<s32> HostPathStat(const char* path, OrbisKernelStat* output, bool follow) {
+    if (!HostBackedPath(path)) {
+        return std::nullopt;
+    }
+    const auto host = Common::Singleton<Core::FileSys::MntPoints>::Instance()->GetHostPath(path);
+    struct stat native;
+    if ((follow ? ::stat(host.c_str(), &native) : ::lstat(host.c_str(), &native)) < 0) {
+        SetPosixErrno(errno);
+        return -1;
+    }
+    ConvertHostStat(*output, native);
+    return 0;
+}
+#endif
+
 s32 PS4_SYSV_ABI open(const char* raw_path, s32 flags, u16 mode) {
     LOG_INFO(Kernel_Fs, "path = {} flags = {:#x} mode = {:#o}", raw_path, flags, mode);
 
@@ -219,6 +265,15 @@ s32 PS4_SYSV_ABI open(const char* raw_path, s32 flags, u16 mode) {
         }
 
         file->type = Core::FileSys::FileType::Directory;
+#ifdef __linux__
+        if (HostBackedPath(file->m_guest_name.c_str())) {
+            auto metadata = std::make_unique<Common::FS::IOFile>(file->m_host_name,
+                                                                 Common::FS::FileAccessMode::Read);
+            if (metadata->IsOpen()) {
+                file->directory_metadata = std::move(metadata);
+            }
+        }
+#endif
         file->is_opened = true;
         if (file->m_guest_name.starts_with("/app0")) {
             // TODO: Properly identify type for paths like "/app0/.."
@@ -883,12 +938,21 @@ s32 PS4_SYSV_ABI posix_chdir(const char* path) {
 }
 
 s32 PS4_SYSV_ABI posix_stat(const char* path, OrbisKernelStat* sb) {
+    if (!path || !sb) {
+        *__Error() = POSIX_EFAULT;
+        return -1;
+    }
     LOG_DEBUG(Kernel_Fs, "(PARTIAL) path = {}", path);
     if (strlen(path) > 255) {
         *__Error() = POSIX_ENAMETOOLONG;
         return -1;
     }
     auto* mnt = Common::Singleton<Core::FileSys::MntPoints>::Instance();
+#ifdef __linux__
+    if (const auto result = HostPathStat(path, sb, true)) {
+        return *result;
+    }
+#endif
     const auto path_name = mnt->GetHostPath(path);
     std::memset(sb, 0, sizeof(OrbisKernelStat));
 
@@ -959,7 +1023,51 @@ s32 PS4_SYSV_ABI posix_stat(const char* path, OrbisKernelStat* sb) {
 }
 
 s32 PS4_SYSV_ABI posix_lstat(const char* path, OrbisKernelStat* sb) {
+#ifdef __linux__
+    if (!path || !sb) {
+        *__Error() = POSIX_EFAULT;
+        return -1;
+    }
+    if (strlen(path) > 255) {
+        *__Error() = POSIX_ENAMETOOLONG;
+        return -1;
+    }
+    if (const auto result = HostPathStat(path, sb, false)) {
+        return *result;
+    }
+    *__Error() = POSIX_EOPNOTSUPP;
+    return -1;
+#else
     return posix_stat(path, sb);
+#endif
+}
+
+s64 PS4_SYSV_ABI posix_readlink(const char* path, char* buffer, u64 bytes) {
+    if (!path || !buffer) {
+        *__Error() = POSIX_EFAULT;
+        return -1;
+    }
+    if (!bytes || bytes > INT64_MAX) {
+        *__Error() = POSIX_EINVAL;
+        return -1;
+    }
+    if (strlen(path) > 255) {
+        *__Error() = POSIX_ENAMETOOLONG;
+        return -1;
+    }
+#ifdef __linux__
+    if (HostBackedPath(path)) {
+        const auto host =
+            Common::Singleton<Core::FileSys::MntPoints>::Instance()->GetHostPath(path);
+        const auto result = ::readlink(host.c_str(), buffer, bytes);
+        if (result < 0) {
+            SetPosixErrno(errno);
+        }
+        return result;
+    }
+#endif
+    *__Error() = POSIX_EOPNOTSUPP;
+    return -1;
 }
 
 s32 PS4_SYSV_ABI sceKernelStat(const char* path, OrbisKernelStat* sb) {
@@ -1005,6 +1113,21 @@ s32 PS4_SYSV_ABI fstat(s32 fd, OrbisKernelStat* sb) {
         *__Error() = POSIX_EBADF;
         return -1;
     }
+#ifdef __linux__
+    auto* metadata = file->GetHostFile();
+    if (!metadata && file->directory_metadata) {
+        metadata = file->directory_metadata.get();
+    }
+    if (metadata && metadata->IsOpen()) {
+        struct stat native;
+        if (::fstat(fileno(metadata->file), &native) < 0) {
+            SetPosixErrno(errno);
+            return -1;
+        }
+        ConvertHostStat(*sb, native);
+        return 0;
+    }
+#endif
     std::memset(sb, 0, sizeof(OrbisKernelStat));
 
     switch (file->type) {
@@ -1442,6 +1565,16 @@ s32 PS4_SYSV_ABI posix_rename(const char* from, const char* to) {
     const bool src_is_dir = fs::is_directory(src_path);
     const bool dst_is_dir = fs::is_directory(dst_path);
 
+#ifdef __linux__
+    if (HostBackedPath(from) && HostBackedPath(to)) {
+        if (::rename(src_path.c_str(), dst_path.c_str()) < 0) {
+            SetPosixErrno(errno);
+            return -1;
+        }
+        return 0;
+    }
+#endif
+
     if (fs::exists(dst_path)) {
         if (src_is_dir && !dst_is_dir) {
             *__Error() = POSIX_ENOTDIR;
@@ -1945,6 +2078,9 @@ s32 PS4_SYSV_ABI posix_pipe(s32* descriptors) {
 }
 
 void RegisterFileSystem(Core::Loader::SymbolsResolver* sym) {
+    LIB_FUNCTION("pd02UI9TbOA", "libkernel", 1, "libkernel", posix_readlink);
+    LIB_FUNCTION("pd02UI9TbOA", "libkernel_sys", 1, "libkernel_sys", posix_readlink);
+    LIB_FUNCTION("pd02UI9TbOA", "libScePosix", 1, "libkernel", posix_readlink);
     LIB_FUNCTION("I7ImcLds-uU", "libkernel", 1, "libkernel", posix_readv);
     LIB_FUNCTION("I7ImcLds-uU", "libScePosix", 1, "libkernel", posix_readv);
     LIB_FUNCTION("Z2aKdxzS4KE", "libkernel", 1, "libkernel", posix_writev);
