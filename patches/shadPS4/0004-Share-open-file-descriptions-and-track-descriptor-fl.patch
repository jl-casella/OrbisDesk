 }
 
+s32 PS4_SYSV_ABI posix_dup(s32 fd) {
+    auto* table = Common::Singleton<Core::FileSys::HandleTable>::Instance();
+    const auto* file = table->GetFile(fd);
+    if (!file) {
+        *__Error() = POSIX_EBADF;
+        return -1;
+    }
+    if (file->type == Core::FileSys::FileType::Socket ||
+        file->type == Core::FileSys::FileType::Equeue) {
+        *__Error() = POSIX_EOPNOTSUPP;
+        return -1;
+    }
+    return table->DuplicateHandle(fd);
+}
+
+s32 PS4_SYSV_ABI posix_fcntl(s32 fd, s32 command, u64 argument) {
+    auto* table = Common::Singleton<Core::FileSys::HandleTable>::Instance();
+    auto* file = table->GetFile(fd);
+    if (!file) {
+        *__Error() = POSIX_EBADF;
+        return -1;
+    }
+    switch (command) {
+    case 0:
+        if (!argument) {
+            return posix_dup(fd);
+        }
+        break;
+    case 1:
+        return table->GetDescriptorFlags(fd);
+    case 2:
+        if (argument & ~u64{1}) {
+            *__Error() = POSIX_EINVAL;
+            return -1;
+        }
+        return table->SetDescriptorFlags(fd, argument);
+    case 3:
+        if (file->type == Core::FileSys::FileType::Socket) {
+            Core::Net::SocketInfo info{};
+            const auto result = Core::Net::SocketGetInfo(fd, &info);
+            if (result.error != Core::Net::Host::Error::Ok) {
+                *__Error() = Libraries::Net::ToOrbisErrno(result.error);
+                return -1;
+            }
+            return ORBIS_KERNEL_O_RDWR | (info.nonblocking ? ORBIS_KERNEL_O_NONBLOCK : 0);
+        }
+        return file->status_flags & (3 | ORBIS_KERNEL_O_NONBLOCK | ORBIS_KERNEL_O_APPEND);
+    case 4: {
+        if (argument & ~u64{3 | ORBIS_KERNEL_O_NONBLOCK | ORBIS_KERNEL_O_APPEND}) {
+            break;
+        }
+        if (file->type == Core::FileSys::FileType::Socket) {
+            if (argument & ORBIS_KERNEL_O_APPEND) {
+                break;
+            }
+            const auto result =
+                Core::Net::SocketSetNonBlocking(fd, argument & ORBIS_KERNEL_O_NONBLOCK);
+            if (result.error != Core::Net::Host::Error::Ok) {
+                *__Error() = Libraries::Net::ToOrbisErrno(result.error);
+                return -1;
+            }
+        } else if (file->type != Core::FileSys::FileType::Regular ||
+                   ((argument ^ file->status_flags) & ORBIS_KERNEL_O_APPEND)) {
+            break;
+        }
+        file->status_flags =
+            (file->status_flags & ~ORBIS_KERNEL_O_NONBLOCK) | (argument & ORBIS_KERNEL_O_NONBLOCK);
+        return 0;
+    }
+    }
+    *__Error() = POSIX_EOPNOTSUPP;
+    return -1;
+}
+
+s32 PS4_SYSV_ABI posix_fstatfs(s32 fd, void* output) {
+    if (!Common::Singleton<Core::FileSys::HandleTable>::Instance()->GetFile(fd)) {
+        *__Error() = POSIX_EBADF;
+    } else if (!output) {
+        *__Error() = POSIX_EFAULT;
+    } else {
+        *__Error() = POSIX_EOPNOTSUPP;
+    }
+    return -1;
+}
