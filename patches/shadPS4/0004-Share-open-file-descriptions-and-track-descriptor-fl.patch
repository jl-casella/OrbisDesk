--- a/src/core/file_sys/fs.cpp
+++ b/src/core/file_sys/fs.cpp
@@ -606,7 +606,7 @@ std::optional<std::vector<u8>> MntPoints::ReadFile(std::string_view guest_path)
 int HandleTable::CreateHandle() {
     std::scoped_lock lock{m_mutex};
 
-    auto* file = new File{};
+    auto file = std::make_shared<File>();
     file->is_opened = false;
 
     int existingFilesNum = m_files.size();
@@ -614,18 +614,55 @@ int HandleTable::CreateHandle() {
     for (int index = 0; index < existingFilesNum; index++) {
         if (m_files.at(index) == nullptr) {
             m_files[index] = file;
+            m_descriptor_flags[index] = 0;
             return index;
         }
     }
 
     m_files.push_back(file);
+    m_descriptor_flags.push_back(0);
     return m_files.size() - 1;
 }
 
 void HandleTable::DeleteHandle(int d) {
     std::scoped_lock lock{m_mutex};
-    delete m_files.at(d);
-    m_files[d] = nullptr;
+    m_files.at(d).reset();
+    m_descriptor_flags.at(d) = 0;
+}
+
+int HandleTable::DuplicateHandle(int d) {
+    std::scoped_lock lock{m_mutex};
+    if (d < 0 || d >= m_files.size() || !m_files[d]) {
+        return -1;
+    }
+    auto file = m_files[d];
+    for (int index = 0; index < m_files.size(); ++index) {
+        if (!m_files[index]) {
+            m_files[index] = file;
+            m_descriptor_flags[index] = 0;
+            return index;
+        }
+    }
+    m_files.push_back(file);
+    m_descriptor_flags.push_back(0);
+    return m_files.size() - 1;
+}
+
+int HandleTable::GetDescriptorFlags(int d) {
+    std::scoped_lock lock{m_mutex};
+    if (d < 0 || d >= m_files.size() || !m_files[d]) {
+        return -1;
+    }
+    return m_descriptor_flags[d];
+}
+
+int HandleTable::SetDescriptorFlags(int d, u32 flags) {
+    std::scoped_lock lock{m_mutex};
+    if (d < 0 || d >= m_files.size() || !m_files[d]) {
+        return -1;
+    }
+    m_descriptor_flags[d] = flags;
+    return 0;
 }
 
