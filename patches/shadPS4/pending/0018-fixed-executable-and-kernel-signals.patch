+    case 416: {
+        const auto result = posix_sigaction(static_cast<s32>(a1), reinterpret_cast<Sigaction*>(a2),
+                                            reinterpret_cast<Sigaction*>(a3));
+        return result < 0 ? -*__Error() : result;
+    }
+    default:
+        LOG_ERROR(Lib_Kernel, "Unsupported raw syscall {}", number);
+        return -POSIX_ENOSYS;
+    }
