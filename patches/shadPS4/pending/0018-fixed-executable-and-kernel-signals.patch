+extern "C" s64 shad_raw_syscall(s64 number, u64 a1, u64 a2, u64 a3, u64, u64, u64) {
+    switch (number) {
+    case 1:
+        return exit(static_cast<s32>(a1));
+    case 4: {
+        const auto result = posix_write(static_cast<s32>(a1), reinterpret_cast<void*>(a2), a3);
