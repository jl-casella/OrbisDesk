+// FreeBSD amd64 jmp_buf layout; host masks stay outside the guest buffer.
+#if defined(__linux__) && defined(ARCH_X86_64)
+
+struct HostJumpState {
+    sigset_t mask;
+    int stack_flags;
+};
+static thread_local std::unordered_map<void*, HostJumpState> jump_states;
+
+extern "C" void shad_jump_save(void* buffer) {
+    auto* bytes = static_cast<unsigned char*>(buffer);
+    HostJumpState state{};
+    sigprocmask(SIG_SETMASK, nullptr, &state.mask);
+    state.stack_flags = g_curthread->sigaltstack.ss_flags;
+    jump_states[buffer] = state;
+    if (*reinterpret_cast<int*>(bytes + 88)) {
+        g_curthread->GetGuestSigmask(*reinterpret_cast<Sigset*>(bytes + 72));
+    }
+}
+
+extern "C" void shad_jump_restore(void* buffer) {
+    auto* bytes = static_cast<unsigned char*>(buffer);
+    const auto saved = jump_states.find(buffer);
+    if (saved != jump_states.end()) {
+        g_curthread->sigaltstack.ss_flags = saved->second.stack_flags;
+    }
+    if (*reinterpret_cast<int*>(bytes + 88)) {
+        g_curthread->SetGuestSigmask(*reinterpret_cast<Sigset*>(bytes + 72));
+        if (saved != jump_states.end()) {
+            sigprocmask(SIG_SETMASK, &saved->second.mask, nullptr);
+        }
+    }
+    s_current_host_context = nullptr;
+}
+
+extern "C" int PS4_SYSV_ABI shad_sigsetjmp(void*, int);
+extern "C" void PS4_SYSV_ABI shad_siglongjmp(void*, int);
+extern "C" int PS4_SYSV_ABI shad_setjmp(void*);
+extern "C" int PS4_SYSV_ABI shad_fast_setjmp(void*);
+extern "C" void PS4_SYSV_ABI shad_longjmp(void*, int);
+extern "C" void PS4_SYSV_ABI shad_fast_longjmp(void*, int);
+
+asm(R"(
+.text
+.globl shad_setjmp
+shad_setjmp:
+    mov $1, %esi
+    jmp shad_sigsetjmp
+.globl shad_fast_setjmp
+shad_fast_setjmp:
+    xor %esi, %esi
+    jmp shad_sigsetjmp
+.globl shad_sigsetjmp
+shad_sigsetjmp:
+    mov %esi, 88(%rdi)
+    mov (%rsp), %rax
+    mov %rax, 0(%rdi)
+    mov %rbx, 8(%rdi)
+    mov %rsp, 16(%rdi)
+    mov %rbp, 24(%rdi)
+    mov %r12, 32(%rdi)
+    mov %r13, 40(%rdi)
+    mov %r14, 48(%rdi)
+    mov %r15, 56(%rdi)
+    fnstcw 64(%rdi)
+    stmxcsr 68(%rdi)
+    sub $8, %rsp
+    call shad_jump_save
+    add $8, %rsp
+    xor %eax, %eax
+    ret
+.globl shad_longjmp
+shad_longjmp:
+    movl $1, 88(%rdi)
+    jmp shad_siglongjmp
+.globl shad_fast_longjmp
+shad_fast_longjmp:
+    movl $0, 88(%rdi)
+    jmp shad_siglongjmp
+.globl shad_siglongjmp
+shad_siglongjmp:
+    push %rdi
+    push %rsi
+    sub $8, %rsp
+    call shad_jump_restore
+    add $8, %rsp
+    pop %rsi
+    pop %rdi
+    mov %esi, %eax
+    test %eax, %eax
+    jnz 1f
+    inc %eax
+1:
+    mov 0(%rdi), %rdx
+    mov 8(%rdi), %rbx
+    mov 16(%rdi), %rsp
+    mov 24(%rdi), %rbp
+    mov 32(%rdi), %r12
+    mov 40(%rdi), %r13
+    mov 48(%rdi), %r14
+    mov 56(%rdi), %r15
+    fninit
+    fldcw 64(%rdi)
+    ldmxcsr 68(%rdi)
+    mov %rdx, (%rsp)
+    ret
+)");
+#endif
