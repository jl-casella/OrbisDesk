+    movq %r8, %r9
+    movq %r10, %r8
+    movq %rdx, %rcx
+    movq %rsi, %rdx
+    movq %rdi, %rsi
+    movq %rax, %rdi
+    call shad_raw_syscall
+    addq $8, %rsp
+    testq %rax, %rax
+    js 1f
+    clc
+    ret
+1:
+    negq %rax
+    stc
+    ret
+)");
+#endif
