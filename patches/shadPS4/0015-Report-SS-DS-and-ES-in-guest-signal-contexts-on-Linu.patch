From 402e97a622eed1f98f69ed1ef1555733a2d19691 Mon Sep 17 00:00:00 2001
From: OrbisWinPrototype <orbis-win@localhost>
Date: Fri, 30 Oct 2026 22:22:09 -0300
Subject: [PATCH] Report SS, DS and ES in guest signal contexts on Linux

Guest handlers that compare the saved stack segment with their own data
selector, as Wine does to recognise 16-bit code, saw SS 0. Take SS from the
Linux context when the kernel saves it (UC_SIGCONTEXT_SS) and the current
selectors otherwise, and report DS and ES as well.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../libraries/kernel/threads/exception.cpp    | 24 +++++++++++++++++++
 1 file changed, 24 insertions(+)

diff --git a/src/core/libraries/kernel/threads/exception.cpp b/src/core/libraries/kernel/threads/exception.cpp
index 3604724..834e627 100644
--- a/src/core/libraries/kernel/threads/exception.cpp
+++ b/src/core/libraries/kernel/threads/exception.cpp
@@ -37,6 +37,25 @@ static constexpr u64 McFpFormatXmm = 0x10002;
 static constexpr u64 McFpOwnedFpu = 0x20001;
 static constexpr int McHasBases = 0x2;
 static constexpr size_t FxsaveSize = 512;
+static constexpr unsigned long LinuxSigcontextSs = 0x2;
+
+static u16 ReadSs() {
+    u16 selector;
+    asm volatile("mov %%ss, %0" : "=r"(selector));
+    return selector;
+}
+
+static u16 ReadDs() {
+    u16 selector;
+    asm volatile("mov %%ds, %0" : "=r"(selector));
+    return selector;
+}
+
+static u16 ReadEs() {
+    u16 selector;
+    asm volatile("mov %%es, %0" : "=r"(selector));
+    return selector;
+}
 
 static int LinuxTrapToOrbis(greg_t trap) {
     static constexpr std::array<int, 20> orbis_traps{18, 10, 19, 3, 20, 21, 1, 22, 23, 24,
@@ -125,6 +144,11 @@ Ucontext::Ucontext(siginfo_t const* inf, ucontext_t* raw_context) {
     uc_mcontext.mc_err = regs[REG_ERR];
     uc_mcontext.mc_rflags = regs[REG_EFL];
     uc_mcontext.mc_cs = regs[REG_CSGSFS] & 0xFFFF;
+    uc_mcontext.mc_ss = (raw_context->uc_flags & LinuxSigcontextSs)
+                            ? (static_cast<u64>(regs[REG_CSGSFS]) >> 48) & 0xFFFF
+                            : ReadSs();
+    uc_mcontext.mc_ds = ReadDs();
+    uc_mcontext.mc_es = ReadEs();
     uc_mcontext.mc_len = sizeof(uc_mcontext);
     uc_mcontext.mc_flags = McHasBases;
     uc_mcontext.mc_fsbase = reinterpret_cast<u64>(Core::GetTcbBase());
-- 
