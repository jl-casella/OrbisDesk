+bool ReachesLocalPair(const std::shared_ptr<LocalPair>& pair, const LocalPair* target,
+                      std::unordered_set<const LocalPair*>& visited) {
+    if (!pair || !visited.insert(pair.get()).second) {
+        return false;
+    }
+    if (pair.get() == target) {
+        return true;
+    }
+    for (const auto& channel : pair->channels) {
+        for (const auto& control : channel.controls) {
+            for (const auto& right : control.rights) {
+                if (right.socket &&
+                    ReachesLocalPair(right.socket->socket->local, target, visited)) {
+                    return true;
+                }
+            }
+        }
+    }
+    return false;
+}
