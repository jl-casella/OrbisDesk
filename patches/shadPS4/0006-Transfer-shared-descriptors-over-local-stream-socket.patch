+namespace {
+
+struct ControlHeader {
+    u32 length;
+    s32 level;
+    s32 type;
+    u32 padding;
+};
+
+constexpr s32 ControlTruncated = 0x20;
+constexpr size_t MaxPassedDescriptors = 253;
+
+int ReadRights(const OrbisNetMsghdr& msg, std::vector<Core::Net::PassedDescriptor>& rights) {
+    if (!msg.msg_controllen) {
+        return 0;
+    }
+    if (!msg.msg_control) {
+        return ORBIS_NET_EFAULT;
+    }
+    if (msg.msg_controllen > 1024 * 1024) {
+        return ORBIS_NET_EMSGSIZE;
+    }
+    auto* table = Common::Singleton<Core::FileSys::HandleTable>::Instance();
+    size_t offset = 0;
+    while (offset < msg.msg_controllen) {
+        if (msg.msg_controllen - offset < sizeof(ControlHeader)) {
+            return ORBIS_NET_EINVAL;
+        }
+        ControlHeader header;
+        const auto* bytes = static_cast<const u8*>(msg.msg_control) + offset;
+        std::memcpy(&header, bytes, sizeof(header));
+        if (header.length < sizeof(header) || header.length > msg.msg_controllen - offset ||
+            (header.length - sizeof(header)) % sizeof(s32)) {
+            return ORBIS_NET_EINVAL;
+        }
+        if (header.level != ORBIS_NET_SOL_SOCKET || header.type != 1) {
+            return ORBIS_NET_EOPNOTSUPP;
+        }
+        for (size_t position = sizeof(header); position < header.length; position += sizeof(s32)) {
+            if (rights.size() == MaxPassedDescriptors) {
+                return ORBIS_NET_EMSGSIZE;
+            }
+            s32 id;
+            std::memcpy(&id, bytes + position, sizeof(id));
+            Core::Net::PassedDescriptor reference;
+            reference.socket = Core::Net::SocketExport(id);
+            if (!reference.socket) {
+                reference.file = table->GetFileReference(id);
+                if (!reference.file) {
+                    return ORBIS_NET_EBADF;
+                }
+                if (reference.file->type == Core::FileSys::FileType::Socket ||
+                    reference.file->type == Core::FileSys::FileType::Equeue) {
+                    return ORBIS_NET_EOPNOTSUPP;
+                }
+            }
+            rights.push_back(std::move(reference));
+        }
+        const size_t aligned = (static_cast<size_t>(header.length) + 7) & ~size_t{7};
+        if (aligned >= msg.msg_controllen - offset) {
+            break;
+        }
+        offset += aligned;
+    }
+    return 0;
+}
+
+void WriteRights(OrbisNetMsghdr& msg, const std::vector<Core::Net::PassedDescriptor>& rights) {
+    const size_t capacity = msg.msg_control ? msg.msg_controllen : 0;
+    msg.msg_controllen = 0;
+    msg.msg_flags = 0;
+    if (rights.empty()) {
+        return;
+    }
+    const size_t count =
+        capacity >= sizeof(ControlHeader)
+            ? std::min(rights.size(), (capacity - sizeof(ControlHeader)) / sizeof(s32))
+            : 0;
+    std::vector<s32> installed;
+    auto* table = Common::Singleton<Core::FileSys::HandleTable>::Instance();
+    for (size_t index = 0; index < count; ++index) {
+        const auto& reference = rights[index];
+        const auto result = reference.socket
+                                ? Core::Net::SocketImport(reference.socket)
+                                : Core::Net::NetResult::Ok(table->InsertHandle(reference.file));
+        if (result.error != Error::Ok || result.value < 0) {
+            break;
+        }
+        installed.push_back(static_cast<s32>(result.value));
+    }
+    if (installed.size() < rights.size()) {
+        msg.msg_flags |= ControlTruncated;
+    }
+    if (!installed.empty()) {
+        ControlHeader header{
+            static_cast<u32>(sizeof(ControlHeader) + installed.size() * sizeof(s32)),
+            ORBIS_NET_SOL_SOCKET, 1, 0};
+        std::memcpy(msg.msg_control, &header, sizeof(header));
+        std::memcpy(static_cast<u8*>(msg.msg_control) + sizeof(header), installed.data(),
+                    installed.size() * sizeof(s32));
+        const size_t aligned = (header.length + 7) & ~size_t{7};
+        msg.msg_controllen = static_cast<u32>(std::min(capacity, aligned));
+        if (msg.msg_controllen > header.length) {
+            std::memset(static_cast<u8*>(msg.msg_control) + header.length, 0,
+                        msg.msg_controllen - header.length);
+        }
+    }
+}
+
