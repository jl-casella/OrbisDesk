     std::vector<u8> buffer;
@@ -2227,6 +2350,14 @@ static s32 sceNetSendmsgImpl(OrbisNetId s, const OrbisNetMsghdr* msg, s32 flags)
         std::memcpy(buffer.data() + offset, msg->msg_iov[i].iov_base, msg->msg_iov[i].iov_len);
         offset += msg->msg_iov[i].iov_len;
     }
+    if (!rights.empty()) {
+        const auto translated = ToHostMsgFlags(flags);
+        if (translated.unsupported || translated.crypto || translated.signature || msg->msg_name) {
+            return SetErrno(ORBIS_NET_EOPNOTSUPP);
+        }
+        return Return(Core::Net::SocketSendTo(s, buffer.data(), buffer.size(), translated.host,
+                                              translated.dontwait, nullptr, 0, rights));
+    }
     return sceNetSendto(s, buffer.data(), buffer.size(), flags,
                         static_cast<const OrbisNetSockaddr*>(msg->msg_name), msg->msg_namelen);
 }
