From bcae5f261c86a79cf7b8ac8ef2bf3f7a9fb2a8c4 Mon Sep 17 00:00:00 2001
From: OrbisWinPrototype <orbis-win@localhost>
Date: Fri, 30 Oct 2026 18:47:08 -0300
Subject: [PATCH] Reject invalid file mmap offsets before host mapping

---
 src/core/libraries/kernel/memory.cpp | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/src/core/libraries/kernel/memory.cpp b/src/core/libraries/kernel/memory.cpp
index ba3d46a..99e9d25 100644
--- a/src/core/libraries/kernel/memory.cpp
+++ b/src/core/libraries/kernel/memory.cpp
@@ -799,6 +799,11 @@ void* PS4_SYSV_ABI posix_mmap(void* addr, u64 len, s32 prot, s32 flags, s32 fd,
                               mem_flags, Core::VMAType::Reserved, "anon", false);
     } else {
         // Default to file mapping
+        if (phys_addr < 0 || !Common::IsAligned(static_cast<u64>(phys_addr), 16_KB)) {
+            ErrSceToPosix(ORBIS_KERNEL_ERROR_EINVAL);
+            LOG_ERROR(Kernel_Vmm, "Invalid file offset {:#x}", phys_addr);
+            return reinterpret_cast<void*>(-1);
+        }
         result = memory->MapFile(&addr_out, aligned_addr, aligned_size, mem_prot, mem_flags, fd,
                                  phys_addr);
     }
-- 
