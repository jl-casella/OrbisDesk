* text=auto eol=lf
*.sh text eol=lf
*.c text eol=lf
*.h text eol=lf
*.py text eol=lf
# Patch checksums must survive Windows/Linux checkouts byte for byte.
# Unified diffs use a single space for an empty context line.
*.patch text eol=lf whitespace=-blank-at-eol,-blank-at-eof
*.json text eol=lf
*.ps1 text eol=lf
*.md text eol=lf
